PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/tropia
JWT_SECRET=sua_chave_secreta_aqui
MP_ACCESS_TOKEN=your_mercado_pago_access_token
FRONTEND_URL=http://localhost:5173

# Upload de fotos — cloudinary.com → Settings → API Keys.
# Sem estas três, o painel avisa e continua aceitando URL colada à mão.
# O SECRET nunca vai para o frontend: ele só assina o upload aqui no servidor.
CLOUDINARY_CLOUD_NAME=mvsuquav
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Melhor Envio — cotação de frete.
# Token em melhorenvio.com.br → Configurações → Tokens. O de sandbox só
# funciona no domínio de sandbox, então os dois trocam juntos.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CEP_ORIGEM=
MELHOR_ENVIO_CONTATO=
